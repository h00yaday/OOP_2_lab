<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab3Json.Pages.BookEditPage"
             Title="Видання">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="8" MaximumWidthRequest="760">

            <Label x:Name="HeaderLabel" Text="Нове видання" FontSize="22" FontAttributes="Bold" />

            <Label Text="Назва *" FontAttributes="Bold" />
            <Entry x:Name="TitleEntry" Placeholder="наприклад: Чистий код" />

            <Label Text="Автори * (через кому)" FontAttributes="Bold" />
            <Entry x:Name="AuthorsEntry" Placeholder="Омельчук Л.Л., Свистунов А.О." />

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto">
                <Label Text="Вид видання *" FontAttributes="Bold" />
                <Entry x:Name="TypeEntry" Grid.Row="1" Placeholder="Підручник" />

                <Label Text="Рік *" FontAttributes="Bold" Grid.Column="1" />
                <Entry x:Name="YearEntry" Grid.Row="1" Grid.Column="1" Keyboard="Numeric" Placeholder="2023" />

                <Label Text="Сторінок" FontAttributes="Bold" Grid.Column="2" />
                <Entry x:Name="PagesEntry" Grid.Row="1" Grid.Column="2" Keyboard="Numeric" Placeholder="необов'язково" />

                <Label Text="Видавництво" FontAttributes="Bold" Grid.Column="3" />
                <Entry x:Name="PublisherEntry" Grid.Row="1" Grid.Column="3" Placeholder="КНУ" />
            </Grid>

            <Label Text="Анотація" FontAttributes="Bold" />
            <Editor x:Name="AnnotationEditor" HeightRequest="80" AutoSize="TextChanges" />

            <Label Text="Читачі — один на рядок: ПІБ; факультет; кафедра; посада" FontAttributes="Bold" />
            <Editor x:Name="ReadersEditor" HeightRequest="110" FontFamily="Consolas"
                    Placeholder="Коваленко Марія Петрівна; ФКНК; ІС; Студент" />

            <Label x:Name="ErrorLabel" TextColor="#C0392B" IsVisible="False" />

            <HorizontalStackLayout Spacing="10" Margin="0,10,0,0">
                <Button Text="Зберегти" Clicked="OnSaveClicked" WidthRequest="140" />
                <Button Text="Скасувати" Clicked="OnCancelClicked" WidthRequest="140" BackgroundColor="Gray" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab3Json.Pages.AboutPage"
             Title="Про програму">

    <VerticalStackLayout Padding="32" Spacing="10" MaximumWidthRequest="700">
        <Label Text="Про програму" FontSize="24" FontAttributes="Bold" />
        <Label Text="Диспетчер JSON — «Кафедральна бібліотека»" FontSize="18" />

        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6" Margin="0,10,0,0">
            <Label Text="ПІБ:" FontAttributes="Bold" />
            <Label x:Name="NameLabel" Grid.Column="1" />
            <Label Text="Курс:" FontAttributes="Bold" Grid.Row="1" />
            <Label x:Name="CourseLabel" Grid.Row="1" Grid.Column="1" />
            <Label Text="Група:" FontAttributes="Bold" Grid.Row="2" />
            <Label x:Name="GroupLabel" Grid.Row="2" Grid.Column="1" />
            <Label Text="Рік:" FontAttributes="Bold" Grid.Row="3" />
            <Label x:Name="YearLabel" Grid.Row="3" Grid.Column="1" />
        </Grid>

        <Label Text="Опис" FontAttributes="Bold" Margin="0,10,0,0" />
        <Label x:Name="DescriptionLabel" LineBreakMode="WordWrap" />

        <Button Text="Закрити" Clicked="OnCloseClicked" WidthRequest="140" HorizontalOptions="Start" Margin="0,16,0,0" />
    </VerticalStackLayout>
</ContentPage>
